{
  "gravityguard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|read_file|write_to_file|replace_file_content|multi_replace_file_content|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 scripts/gravity-validator.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp_.*code[_-]review",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 scripts/gravity-validator.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -X utf8 scripts/gravity-validator.py --stop",
        "timeout": 15
      }
    ]
  }
}