{
  "name": "gravityguard",
  "displayName": "GravityGuard — Architecture Airbag & Gatekeeper for AI Agents",
  "description": "Deterministic architectural gatekeeper, test sufficiency analyzer, and prompt engineering copilot for Antigravity IDE & AI Coding Agents.",
  "version": "1.4.0",
  "publisher": "halilogia",
  "repository": {
    "type": "git",
    "url": "https://github.com/halilogia/GravityGuard.git"
  },
  "bugs": {
    "url": "https://github.com/halilogia/GravityGuard/issues"
  },
  "homepage": "https://github.com/halilogia/GravityGuard#readme",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "ai-agent",
    "architecture",
    "srp",
    "gatekeeper",
    "clean-code",
    "prompt-engineering"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "test:engine": "python -m unittest discover -s engine -t engine -p \"test_*.py\"",
    "package": "vsce package --no-git-tag-version",
    "verify:package": "python tools/verify_package.py"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gravityguard-sidebar",
          "title": "GravityGuard",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "gravityguard-sidebar": [
        {
          "type": "webview",
          "id": "antigravity-guardian-view",
          "name": "GravityGuard Live Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityBridge.enhancePrompt",
        "title": "GravityGuard: Prompt Geliştir / Enhance",
        "icon": "$(sparkle)"
      },
      {
        "command": "antigravityBridge.ping",
        "title": "GravityGuard: Ping Status (yerel AI geçidi kontrolü)"
      },
      {
        "command": "antigravityBridge.refreshLogs",
        "title": "GravityGuard: Refresh Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityBridge.clearLogs",
        "title": "GravityGuard: Clear Logs",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravityBridge.enhancePrompt",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "GravityGuard",
      "properties": {
        "gravityguard.routerToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for the local AI gateway. If empty, GRAVITYGUARD_ROUTER_TOKEN or ROUTER_TOKEN env var is used."
        },
        "gravityguard.routerHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Hostname of the local AI gateway (9Router, Ollama, LM Studio, llama.cpp — any OpenAI-compatible /v1 endpoint)."
        },
        "gravityguard.routerPort": {
          "type": "number",
          "default": 20128,
          "description": "Port of the local AI gateway."
        },
        "gravityguard.routerTimeoutMs": {
          "type": "number",
          "default": 12000,
          "description": "Per-model request timeout in milliseconds. A connection-level failure (gateway down) skips the remaining models immediately instead of waiting for each timeout."
        },
        "gravityguard.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ag/gemini-3.8-flash-low",
            "ag/gemini-3.7-flash-medium",
            "all"
          ],
          "description": "Model cascade, tried in order. Any OpenAI-compatible model id works (e.g. ollama: \"llama3.1\", LM Studio: \"local-model\"). When every model fails, GravityGuard falls back to the offline deterministic composer instead of erroring."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.107.0",
    "typescript": "^5.9.3"
  }
}
